{
  "name": "diapo-engine",
  "version": "0.3.0",
  "private": true,
  "description": "Moteur de présentations codées avec scènes animées et continuité entre les pages.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test packages/core/tests/*.test.ts apps/web/tests/*.test.js",
    "validate": "node scripts/validate-presentation.ts",
    "dev": "node scripts/serve-web.mjs",
    "build": "node scripts/build-web.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "author": "Ibrahim Bouillet"
}
